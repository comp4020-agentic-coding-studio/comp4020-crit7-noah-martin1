---
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import Shell from "../layouts/Shell.astro";
import { CURRENT_TERM, GRADES, TERMS, TERM_ORDER } from "../lib/catalog";
import { formatDate } from "../lib/format";
import { loadHub } from "../lib/hub";
import { gpa, wam } from "../lib/rules";

const hub = loadHub();
const { student, rows } = hub;
const completed = rows.filter((r) => r.status === "completed");
const terms = TERM_ORDER.filter((t) => rows.some((r) => r.term === t && (r.status === "completed" || r.status === "enrolled")));
const byTerm = terms.map((t) => {
  const items = rows.filter((r) => r.term === t && (r.status === "completed" || r.status === "enrolled" || r.status === "dropped")).sort((a, b) => a.courseCode.localeCompare(b.courseCode));
  const done = items.filter((r) => r.status === "completed");
  return { term: t, items, gpa: gpa(done), wam: wam(done), units: done.reduce((s, r) => s + r.course.units, 0), pending: items.some((r) => r.status === "enrolled") };
});
const dist = GRADES.map((g) => ({ ...g, count: completed.filter((r) => r.grade === g.grade).length }));
const maxCount = Math.max(1, ...dist.map((d) => d.count));
const units = completed.reduce((s, r) => s + r.course.units, 0);
const hds = dist.find((d) => d.grade === "HD")?.count ?? 0;

// term GPA line: one series, direct-labelled, on a fixed 4–7 scale
const trend = byTerm.filter((t) => !t.pending);
const W = 560;
const H = 180;
const PAD = { l: 34, r: 16, t: 24, b: 30 };
const x = (i: number) => PAD.l + (trend.length > 1 ? (i * (W - PAD.l - PAD.r)) / (trend.length - 1) : 0);
const y = (v: number) => PAD.t + ((7 - v) / 3) * (H - PAD.t - PAD.b);
const path = trend.map((t, i) => `${i ? "L" : "M"}${x(i).toFixed(1)},${y(t.gpa).toFixed(1)}`).join(" ");
const area = `${path} L${x(trend.length - 1).toFixed(1)},${H - PAD.b} L${x(0).toFixed(1)},${H - PAD.b} Z`;
const best = trend.reduce((a, b) => (b.gpa > a.gpa ? b : a), trend[0]);
---

<Shell title="Academic Records" nav="records" art="hero-records">
  <Hero art="hero-records" eyebrow="Academic Records" icon="records" favourite={{ path: "/records/", label: "Academic Records" }}>
    <h1 id="page-title" slot="title">Every result, <em>in one place</em></h1>
    <p class="hero__lede" slot="lede">
      {completed.length} courses and {units} units completed since {TERMS[student.admitTerm].label}. {TERMS[CURRENT_TERM].label} results are released on 26 November.
    </p>
    <div class="hero__stats">
      <span class="stat-pill"><small>GPA (7-point)</small><strong>{hub.gpa.toFixed(2)}</strong></span>
      <span class="stat-pill"><small>WAM</small><strong>{hub.wam.toFixed(1)}</strong></span>
      <span class="stat-pill"><small>Units passed</small><strong>{units}</strong></span>
      <span class="stat-pill"><small>High Distinctions</small><strong>{hds}</strong></span>
    </div>
  </Hero>

  <div class="grid charts">
    <section class="card rise" style="--i:1" aria-labelledby="dist-title">
      <div class="card__head">
        <span class="card__icon card__icon--gold"><Icon name="trophy" /></span>
        <h2 id="dist-title">Grade distribution</h2>
      </div>
      <ul class="dist">
        {
          dist.map((d, i) => (
            <li title={`${d.label}: ${d.count} course${d.count === 1 ? "" : "s"}`}>
              <span class="dist__grade">{d.grade}</span>
              <span class="dist__label">{d.label}</span>
              <span class="dist__track">
                <span class="dist__bar" style={`--w:${(d.count / maxCount) * 100}%;--delay:${0.15 + i * 0.08}s`} />
              </span>
              <span class="dist__n">{d.count}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="card rise" style="--i:2" aria-labelledby="trend-title">
      <div class="card__head">
        <span class="card__icon"><Icon name="route" /></span>
        <h2 id="trend-title">GPA by semester</h2>
      </div>
      <svg class="trend" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Semester GPA from ${trend[0]?.gpa.toFixed(2)} to ${trend[trend.length - 1]?.gpa.toFixed(2)}; best ${best?.gpa.toFixed(2)} in ${best ? TERMS[best.term].label : ""}. Full figures in the transcript below.`}>
        {
          [4, 5, 6, 7].map((v) => (
            <g>
              <line x1={PAD.l} x2={W - PAD.r} y1={y(v)} y2={y(v)} class="grid-line" />
              <text x={PAD.l - 10} y={y(v) + 4} class="axis" text-anchor="end">{v}</text>
            </g>
          ))
        }
        <path d={area} class="trend__area" />
        <path d={path} class="trend__line" pathLength="1" />
        {
          trend.map((t, i) => (
            <g class="trend__pt">
              <circle cx={x(i)} cy={y(t.gpa)} r="14" class="hit">
                <title>
                  {TERMS[t.term].label}: GPA {t.gpa.toFixed(2)}, WAM {t.wam.toFixed(1)}
                </title>
              </circle>
              <circle cx={x(i)} cy={y(t.gpa)} r="5" class="dot" style={`--i:${i}`} />
              {(t === best || i === trend.length - 1) && (
                <text x={x(i)} y={y(t.gpa) - 12} text-anchor="middle" class="val">
                  {t.gpa.toFixed(2)}
                </text>
              )}
              <text x={x(i)} y={H - 8} text-anchor="middle" class="axis">
                {TERMS[t.term].short}
              </text>
            </g>
          ))
        }
      </svg>
    </section>
  </div>

  <section class="section" id="transcript" aria-labelledby="transcript-title">
    <div class="section-head">
      <div>
        <h2 id="transcript-title">Unofficial transcript</h2>
        <p>{student.legalGiven} {student.legalFamily} · {student.uid} · {student.programName}</p>
      </div>
      <div class="row no-print">
        <button class="btn btn--ghost btn--sm" type="button" onclick="document.querySelectorAll('#transcript details').forEach(d=>d.open=true);print()"><Icon name="printer" size={16} />Print</button>
        <a class="btn btn--ghost btn--sm" href="/requests/?type=transcript#new"><Icon name="records" size={16} />Official copy</a>
      </div>
    </div>
    <div class="stack">
      {
        [...byTerm].reverse().map((t, i) => (
          <details class="disclosure rise" open={i < 2} style={`--i:${i}`}>
            <summary>
              <span class:list={["term-dot", t.pending && "term-dot--now"]} aria-hidden="true" />
              <strong>{TERMS[t.term].label}</strong>
              <span class="muted">{t.pending ? "In progress — results 26 Nov" : `${t.units} units · GPA ${t.gpa.toFixed(2)} · WAM ${t.wam.toFixed(1)}`}</span>
              <Icon name="chevron-down" class="chev" />
            </summary>
            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Course</th>
                    <th scope="col" class="num">Units</th>
                    <th scope="col" class="num">Mark</th>
                    <th scope="col">Grade</th>
                  </tr>
                </thead>
                <tbody>
                  {t.items.map((r) => (
                    <tr>
                      <td>
                        <span class="code">{r.courseCode}</span> {r.course.title}
                      </td>
                      <td class="num">{r.course.units}</td>
                      <td class="num">{r.mark ?? "—"}</td>
                      <td>
                        {r.status === "completed" && <span class:list={["grade", `grade--${r.grade}`]}>{r.grade}</span>}
                        {r.status === "enrolled" && <span class="chip chip--info">Enrolled</span>}
                        {r.status === "dropped" && <span class="chip">Withdrawn</span>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        ))
      }
    </div>
    <p class="muted small">Printed {formatDate(hub.today, { day: "numeric", month: "long", year: "numeric" })}. Unofficial — request an official transcript for employers or other universities.</p>
  </section>

  <section class="section card card--tint" aria-labelledby="scale-title">
    <div class="card__head">
      <span class="card__icon card__icon--plain"><Icon name="info" /></span>
      <h2 id="scale-title">How grades and GPA work</h2>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th scope="col">Grade</th><th scope="col">Meaning</th><th scope="col" class="num">Marks</th><th scope="col" class="num">GPA points</th></tr>
        </thead>
        <tbody>
          {GRADES.map((g, i) => <tr><td><span class:list={["grade", `grade--${g.grade}`]}>{g.grade}</span></td><td>{g.label}</td><td class="num">{g.min}–{i === 0 ? 100 : GRADES[i - 1].min - 1}</td><td class="num">{g.points}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="muted small">GPA is the unit-weighted average of grade points; WAM is the unit-weighted average of marks.</p>
  </section>
</Shell>

<style>
  .charts {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }
  .dist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .dist li {
    display: grid;
    grid-template-columns: 34px 120px 1fr 26px;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
  }
  .dist__grade {
    font-weight: 750;
  }
  .dist__label {
    color: var(--muted);
  }
  .dist__track {
    height: 14px;
    border-radius: 4px;
    background: var(--track);
    overflow: hidden;
  }
  .dist__bar {
    display: block;
    height: 100%;
    width: var(--w);
    border-radius: 0 4px 4px 0;
    background: var(--gold);
    animation: grow 1s var(--ease-out) both;
    animation-delay: var(--delay);
  }
  .dist__n {
    text-align: right;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .trend {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .grid-line {
    stroke: var(--line);
    stroke-width: 1;
  }
  .axis {
    fill: var(--muted);
    font-size: 11px;
    font-weight: 600;
  }
  .val {
    fill: var(--ink);
    font-size: 12px;
    font-weight: 700;
  }
  .trend__area {
    fill: color-mix(in oklab, var(--teal) 12%, transparent);
    animation: fade 1s ease both 0.6s;
  }
  .trend__line {
    fill: none;
    stroke: var(--teal);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.4s var(--ease-out) forwards 0.2s;
  }
  .dot {
    fill: var(--teal);
    stroke: var(--surface);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    animation: pop-dot 0.5s var(--ease-spring) both;
    animation-delay: calc(var(--i) * 120ms + 0.3s);
    transition: r var(--fast);
  }
  .hit {
    fill: transparent;
    cursor: pointer;
  }
  .trend__pt:hover .dot {
    r: 7;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @keyframes pop-dot {
    from {
      transform: scale(0);
    }
  }
  .term-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--gold);
    flex: none;
  }
  .term-dot--now {
    background: var(--teal);
  }
  .grade {
    display: inline-grid;
    place-items: center;
    min-width: 38px;
    padding: 2px 8px;
    border-radius: 8px;
    font-weight: 750;
    font-size: 0.8rem;
    background: var(--surface-3);
  }
  .grade--HD {
    background: var(--gold-soft);
    color: var(--gold-ink);
  }
  .grade--D {
    background: var(--teal-soft);
    color: var(--teal-strong);
  }
  .grade--N {
    background: var(--rust-soft);
    color: var(--rust);
  }
  .small {
    font-size: 0.85rem;
    margin-top: 12px;
  }
  @media (max-width: 1020px) {
    .charts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .dist li {
      grid-template-columns: 30px 1fr 26px;
    }
    .dist__label {
      display: none;
    }
  }
</style>
